[Unit]
Description=Monitor Agent (metrics + log alerts)
Documentation=file:__MONITOR_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 旧版 systemd（< 235，如 CentOS 7）不支持 RuntimeDirectory/StateDirectory/LogsDirectory，
# 因此由 ExecStartPre 手工创建运行目录；其余加固选项在 systemd 219+ 均可用。
EnvironmentFile=-/etc/monitor-agent/env
Environment=MONITOR_LOG_FILE=/var/log/monitor-agent/monitor-agent.log
Environment=PID_FILE=/run/monitor-agent/monitor-agent.pid
Environment=ALERT_HISTORY_FILE=/var/lib/monitor-agent/alerts.jsonl
Environment=ALERT_STATE_FILE=/var/lib/monitor-agent/alert-state.json
Environment=SKIP_NOTIFY_FILE=/var/lib/monitor-agent/skip-notified.json
ExecStartPre=/bin/mkdir -p /run/monitor-agent /var/lib/monitor-agent /var/log/monitor-agent
ExecStart=__PYTHON_BIN__ __MONITOR_DIR__/main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/monitor-agent /run/monitor-agent /var/log/monitor-agent

[Install]
WantedBy=multi-user.target
